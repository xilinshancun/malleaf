{
  "worktree": {
    "setup": [
      "npm ci",
      "node ./scripts/seed-ios-native-cache.mjs",
      "npm run build:server",
      "npm run build --workspace=@getpaseo/expo-two-way-audio"
    ]
  },
  "scripts": {
    "daemon": {
      "type": "service",
      "command": "./scripts/dev-daemon.sh --listen 127.0.0.1:${PASEO_PORT:-6778}"
    },
    "app": {
      "type": "service",
      "command": "EXPO_PORT=${PASEO_PORT:-} ./scripts/dev-app.sh --listen 127.0.0.1:${PASEO_SERVICE_DAEMON_PORT:-6778}"
    },
    "desktop": {
      "type": "service",
      "command": "EXPO_PORT=${PASEO_PORT:-} exec ./packages/desktop/scripts/dev.sh --listen 127.0.0.1:${PASEO_SERVICE_DAEMON_PORT:-6778}"
    },
    "ios-simulator": {
      "type": "service",
      "command": "./scripts/paseo-ios-simulator-service.sh --listen 127.0.0.1:${PASEO_SERVICE_DAEMON_PORT:-6778}"
    },
    "typecheck": {
      "command": "npm run typecheck"
    }
  }
}
